# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://aparis:aparis@localhost:5432/aparis_ai_engine?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=change-me-admin-secret

# API Keys (comma-separated master keys for bootstrap; production uses DB)
MASTER_API_KEYS=

# Ollama (https://ai.aparis.io)
OLLAMA_BASE_URL=https://ai.aparis.io
OLLAMA_CHAT_MODEL=deepseek-r1:latest
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_MS=120000

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# CORS
CORS_ORIGIN=https://api-ai.aparis.io,https://studio.aparis.io,http://localhost:5173
