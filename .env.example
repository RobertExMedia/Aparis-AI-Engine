# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Operational DB (usage logs / future server API keys — NOT hub tenants)
DATABASE_URL=postgresql://aparis:aparis@localhost:5432/aparis_ai_engine?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Supabase (Aparis AI Hub / Lovable Cloud)
# Use the publishable/anon key. Service role is NOT required for playground chat
# (Engine validates the user JWT and reads/writes under RLS).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional — leave unset on Lovable Cloud
# SUPABASE_SERVICE_ROLE_KEY=

# Ollama (xCloud)
OLLAMA_BASE_URL=https://ai.aparis.io
OLLAMA_CHAT_ENDPOINT=/api/chat
OLLAMA_MODELS_ENDPOINT=/api/tags
OLLAMA_EMBEDDINGS_ENDPOINT=/api/embeddings
OLLAMA_CHAT_MODEL=deepseek-r1:1.5b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_REQUEST_TIMEOUT_MS=120000
# Optional comma-separated allowlist for agents.settings.model
OLLAMA_ALLOWED_MODELS=

# Internal JWT / API keys (server-to-server only — not Hub playground)
JWT_SECRET=change-me-to-a-long-random-secret
API_KEY_HASH_SECRET=change-me-api-key-pepper
# Hashed master/server API key (from npm run generate-api-key) — never commit a real value
API_KEY_HASHED=
MASTER_API_KEYS=

# CORS — Aparis AI Hub origins
ALLOWED_ORIGINS=https://studio.aparis.io,http://localhost:5173,http://localhost:8080

# Knowledge / RAG (optional overrides)
KNOWLEDGE_MAX_FILE_SIZE_BYTES=26214400
KNOWLEDGE_MAX_FILES_PER_SOURCE=50
KNOWLEDGE_MAX_PDF_PAGES=200
KNOWLEDGE_MAX_EXTRACTED_CHARS=2000000
KNOWLEDGE_MAX_CHUNKS_PER_SOURCE=5000
KNOWLEDGE_TOP_K=8
KNOWLEDGE_SIMILARITY_THRESHOLD=0.25
KNOWLEDGE_PROCESS_SYNC_MAX_BYTES=524288

# AI Credits (internal conversion — never expose to clients)
# credits = max(MIN, ceil((prompt + completion * WEIGHT) / TOKENS_PER_CREDIT))
AI_CREDITS_TOKENS_PER_CREDIT=1000
AI_CREDITS_COMPLETION_WEIGHT=1
AI_CREDITS_MIN_PER_REQUEST=1

# Website widget API requires service role (Hub tables: widget_keys, agent_domains)
# SUPABASE_SERVICE_ROLE_KEY=
