{
  "name": "aparis-ai-engine",
  "version": "1.0.0",
  "description": "Production-grade AI backend engine powering Aparis products",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "generate-api-key": "node dist/cli/generate-api-key.js",
    "verify-api-key": "node dist/cli/verify-api-key.js"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ai",
    "aparis",
    "api",
    "ollama"
  ],
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^9.0.4",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "@prisma/client": "^6.3.1",
    "@supabase/supabase-js": "^2.111.0",
    "axios": "^1.7.9",
    "bullmq": "^5.34.10",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "jose": "^6.2.5",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.3.1",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
